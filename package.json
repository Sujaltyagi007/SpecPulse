{
  "name": "specpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "validate": "tsx scripts/validate.ts",
    "ingest:prices": "tsx scripts/refresh-prices.ts",
    "publish:batch": "tsx scripts/publish.ts",
    "content:generate": "tsx scripts/generate-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "lucide-react": "^1.60.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "openai": "7.39.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
